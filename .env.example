# Clerk Authentication
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Yowimo API (local: http://api-yowimo.test/api/v1, prod: https://api.yowimo.com/api/v1)
EXPO_PUBLIC_API_URL=http://api-yowimo.test/api/v1

# PostHog Analytics
POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://us.i.posthog.com

# Paystack (public/test key only — the secret key stays backend-only)
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Reverb (realtime game/party channels) — get these from the backend team per environment.
# The app key is public; REVERB_APP_SECRET must never appear on the client.
EXPO_PUBLIC_REVERB_APP_KEY=xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVERB_HOST=api-yowimo.test
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http

# AdMob — register your own app in the AdMob console for production App IDs. The values below
# are Google's own published sample App IDs, safe for local dev/testing only.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511